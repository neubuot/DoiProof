{
  "name": "doiproof-pruefer",
  "version": "1.0.0",
  "private": true,
  "description": "Lokaler und optionaler Online-Prüfer für DoiProof-Beweispakete mit PDF-Prüfbericht",
  "main": "main.cjs",
  "author": "Ottmar Neuburger",
  "license": "MIT",
  "scripts": {
    "prepare:verifier": "node prepare.mjs",
    "start": "npm run prepare:verifier && electron .",
    "dist:win": "npm run prepare:verifier && electron-builder --win portable --publish never",
    "test": "npm run prepare:verifier && node --test desktop.test.mjs",
    "smoke": "npm run prepare:verifier && electron . --smoke"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "jszip": "3.10.2",
    "pdf-lib": "1.17.1",
    "qrcode-generator": "2.0.4"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "org.doichain.doiproof.verifier",
    "productName": "DoiProof Prüfer",
    "copyright": "Copyright © 2026 Ottmar Neuburger",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "renderer.js",
      "index.html",
      "styles.css",
      "report.mjs",
      "details.mjs",
      "core/**/*.mjs",
      "fonts/**/*",
      "assets/icon.ico",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "icon": "assets/icon.ico",
      "artifactName": "DoiProof-Pruefer-${version}-Windows.exe",
      "signAndEditExecutable": false
    },
    "asar": true,
    "publish": null
  }
}
